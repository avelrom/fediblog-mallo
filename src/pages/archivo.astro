---
import { isOff } from '@fediblog/core/lib/flags';
import Base from '../layouts/Base.astro';
import { getNotas, getTags } from '@fediblog/core/lib/notas';
import { SITE } from '../config';

if (isOff(SITE.archive?.show)) return Astro.redirect(import.meta.env.BASE_URL);

const notas = await getNotas();
const tags = await getTags();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface ArchivePhoto {
  src: string;
  href: string;
  title: string;
  alt: string;
  width?: number;
  height?: number;
}

const photos: ArchivePhoto[] = notas.flatMap((nota) => {
  const href = `${base}${nota.id}/`;
  if (!nota.data.images || nota.data.images.length === 0) {
    return [{
      src: '',
      href,
      title: nota.data.title,
      alt: nota.data.title,
    }];
  }
  return nota.data.images.map((img) => ({
    src: img.src,
    href,
    title: nota.data.title,
    alt: img.alt || nota.data.title || '',
    width: img.width,
    height: img.height,
  }));
});
---

<Base wide={true} title="Archivo" description={`Archivo visual de ${SITE.site.title}.`}>
  <section class="archive-page">
    <header class="archive-header">
      <div class="archive-headline">
        <h1 class="archive-title">Archivo</h1>
        <p class="archive-count">{photos.length} {photos.length === 1 ? 'fotografía' : 'fotografías'} en total</p>
      </div>

      {tags.length > 0 && (
        <nav class="archive-tags" aria-label="Etiquetas">
          <ul>
            {tags.map((t) => (
              <li>
                <a href={`${base}etiquetas/${t.slug}/`}>#{t.name} <span class="count">{t.count}</span></a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </header>

    <div class="archive-grid">
      {photos.map((p) => (
        <a class="archive-tile" href={p.href} title={p.title} aria-label={p.title}>
          {p.src ? (
            <img
              src={p.src.startsWith('http') || p.src.startsWith('/') ? p.src : `${base}${p.src}`}
              alt={p.alt}
              loading="lazy"
              class="archive-img"
              width={p.width}
              height={p.height}
              style={p.width && p.height ? `aspect-ratio: ${p.width} / ${p.height};` : undefined}
            />
          ) : (
            <span class="archive-fallback" aria-hidden="true">Aa</span>
          )}
        </a>
      ))}
    </div>

    {photos.length === 0 && <p class="archive-empty">Todavía no hay publicaciones.</p>}
  </section>
</Base>

<style>
  .archive-page {
    width: 100%;
    max-width: var(--max-w-wide);
    margin: 0 auto;
    padding: 0.5rem 0 3.5rem;
    box-sizing: border-box;
  }

  .archive-header {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .archive-headline {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .archive-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-title);
    margin: 0;
    line-height: 1.2;
  }

  .archive-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .archive-tags ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }

  .archive-tags a {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.2rem 0.55rem;
    transition: color 0.15s ease, background-color 0.15s ease;
    text-decoration: none;
  }

  .archive-tags a:hover {
    color: var(--text-title);
    background: var(--bg-hover);
  }

  .archive-tags .count {
    opacity: 0.55;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    margin-left: 0.15rem;
  }

  /* Cuadrícula visual continua de imágenes */
  .archive-grid {
    column-count: 6;
    column-gap: 0.85rem;
    width: 100%;
  }

  @media (max-width: 1250px) {
    .archive-grid {
      column-count: 5;
      column-gap: 0.75rem;
    }
  }

  @media (max-width: 950px) {
    .archive-grid {
      column-count: 4;
      column-gap: 0.65rem;
    }
  }

  @media (max-width: 650px) {
    .archive-grid {
      column-count: 3;
      column-gap: 0.5rem;
    }
  }

  @media (max-width: 420px) {
    .archive-grid {
      column-count: 2;
      column-gap: 0.4rem;
    }
  }

  .archive-tile {
    display: block;
    margin-bottom: 0.85rem;
    break-inside: avoid;
    overflow: hidden;
    line-height: 0;
    cursor: pointer;
    background: var(--bg-subtle);
    border-radius: 0 !important;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .archive-tile:hover {
    opacity: 0.86;
  }

  .archive-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  .archive-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 120px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .archive-empty {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 2rem;
  }
</style>
