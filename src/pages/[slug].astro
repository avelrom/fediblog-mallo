---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getNotas, type Nota } from '@fediblog/core/lib/notas';
import { formatDate } from '@fediblog/core/lib/format';
import { slugify } from '@fediblog/core/lib/slug';
import { SITE } from '../config';
import ContentWarning from '@fediblog/core/components/ContentWarning.astro';
import Engagement from '@fediblog/core/components/Engagement.astro';
import Comments from '@fediblog/core/components/Comments.astro';

export async function getStaticPaths() {
  const notas = await getNotas();
  return notas.map((nota, idx) => ({
    params: { slug: nota.id },
    props: {
      nota,
      prev: idx < notas.length - 1 ? notas[idx + 1] : null,
      next: idx > 0 ? notas[idx - 1] : null,
    },
  }));
}

interface Props {
  nota: Nota;
  prev: Nota | null;
  next: Nota | null;
}

const { nota, prev, next } = Astro.props;
const { Content } = await render(nota);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const images = nota.data.images || [];
const formattedDate = formatDate(nota.data.date, 'dd/mm/yyyy');
const resolveUrl = (src: string) => {
  if (!src) return '';
  if (/^https?:\/\//.test(src) || src.startsWith('data:') || src.startsWith('/')) return src;
  return `${base}${src}`;
};
---

<Base
  isPost
  title={nota.data.title}
  description={nota.data.excerpt || SITE.site.description}
  image={resolveUrl(images[0]?.src)}
>
  <article class="single-post">
    <div class="subpage-nav-bar">
      <a href={base} class="back-link">&larr; Volver a la galería</a>
    </div>

    <header class="post-header">
      <div class="post-meta">
        <a href={nota.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="post-date-link" title="Abrir la publicación original">
          <time datetime={nota.data.date.toISOString()} class="post-date">{formattedDate}</time>
        </a>
      </div>
      {nota.data.title && !nota.data.title.startsWith('Foto del') && (
        <h1 class="post-title">{nota.data.title}</h1>
      )}
    </header>

    {images.length > 0 && (
      <figure class="post-figure">
        <img
          src={resolveUrl(images[0].src)}
          alt={images[0].alt || nota.data.title || ''}
          loading="eager"
          class="post-img"
        />
        {images[0].alt && images[0].alt !== nota.data.title && (
          <figcaption class="post-caption">{images[0].alt}</figcaption>
        )}
      </figure>
    )}

    {nota.data.cw ? (
      <ContentWarning cw={nota.data.cw}><div class="post-body"><Content /></div></ContentWarning>
    ) : (
      <div class="post-body"><Content /></div>
    )}

    {nota.data.tags.length > 0 && (
      <div class="post-tags">
        {nota.data.tags.map((t) => (
          <a class="tag-badge" href={`${base}etiquetas/${slugify(t)}/`}>#{t}</a>
        ))}
      </div>
    )}

    {SITE.post.showMetrics && (
      <Engagement likes={nota.data.likes} shares={nota.data.shares} sourceUrl={nota.data.sourceUrl} previewHooks data-preview-field="post.showMetrics" data-preview-label="Métricas (me gusta / compartidos)" data-preview-group="Entrada" />
    )}

    {SITE.post.showComments && (
      <Comments comments={nota.data.comments} count={nota.data.commentCount} sourceUrl={nota.data.sourceUrl} previewHooks locale={SITE.site.locale} avatars={SITE.post.commentAvatars} data-preview-field="post.showComments" data-preview-label="Mostrar comentarios" data-preview-group="Comentarios" />
    )}

    <nav class="post-nav" aria-label="Navegación entre fotos">
      {prev ? (
        <a href={`${base}${prev.id}/`} class="nav-prev">
          &larr; {prev.data.title}
        </a>
      ) : <span />}
      {next ? (
        <a href={`${base}${next.id}/`} class="nav-next">
          {next.data.title} &rarr;
        </a>
      ) : <span />}
    </nav>
  </article>
</Base>

<style>
  .subpage-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--text-title);
  }

  .single-post {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .post-header {
    margin-bottom: 1.5rem;
  }

  .post-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .post-date-link {
    color: inherit;
    text-decoration: none;
  }
  .post-date-link:hover {
    color: var(--text-title);
  }

  .post-title {
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-title);
  }

  .post-gallery {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 1.5rem 0 2rem;
  }

  .post-figure {
    width: 100%;
    margin: 0;
  }

  .post-img {
    width: 100%;
    height: auto;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  .post-caption {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-weight: 300;
    margin-top: 0.5rem;
    text-align: center;
  }

  .post-body {
    font-size: 0.84rem;
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.015em;
    margin: 2rem 0;
  }

  .post-body :global(p) {
    margin: 0 0 1.25em;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .tag-badge {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
  }

  .post-nav a:hover {
    text-decoration: underline;
  }
</style>
